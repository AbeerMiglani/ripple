# =============================================================================
# Ripple — Environment Variables
# Copy this file to .env and adjust as needed.
# =============================================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=ripple
POSTGRES_PASSWORD=ripple_dev
POSTGRES_DB=ripple
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://ripple:ripple_dev@postgres:5432/ripple

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ripple_dev_neo4j
# Auth format for the Docker container
NEO4J_AUTH=neo4j/ripple_dev_neo4j

# --- Redis ---
REDIS_URL=redis://:ripple_dev@redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://:ripple_dev@redis:6379/0
CELERY_RESULT_BACKEND=redis://:ripple_dev@redis:6379/1

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Cascade semantics ---
# Respect what each link actually delivers, so a blocked road does not
# de-energise an electrical tower while a hospital still requires both power
# and water. Set to false for pure load-overload Motter-Lai propagation.
ENFORCE_EDGE_SEMANTICS=true

# --- Baseline topology source ---
# "synthetic" reads the committed seed fixture in data/seed.
# "osm" pulls the real road network for OSM_PLACE through the OSMnx pipeline
# and ingests that instead. Requires the optional dependency:
#   pip install 'ripple-backend[osm]'
TOPOLOGY_SOURCE=synthetic
OSM_PLACE=Manipal, Karnataka, India
OSM_NETWORK_TYPE=drive
OSM_CACHE_DIR=/data/osm
