# =============================================================================
# Ripple — Environment Variables
# Copy this file to .env and adjust as needed.
# =============================================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=ripple
POSTGRES_PASSWORD=ripple_dev
POSTGRES_DB=ripple
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://ripple:ripple_dev@postgres:5432/ripple

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ripple_dev_neo4j
# Auth format for the Docker container
NEO4J_AUTH=neo4j/ripple_dev_neo4j

# --- Redis ---
REDIS_URL=redis://:ripple_dev@redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://:ripple_dev@redis:6379/0
CELERY_RESULT_BACKEND=redis://:ripple_dev@redis:6379/1

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Caching ---
# A completed run's ranked recommendations are cached in Redis for this long
# (seconds); they never change once the run completes. 0 disables the cache.
RECOMMENDATION_CACHE_TTL_SECONDS=3600

# --- Cascade semantics ---
# Respect what each link actually delivers, so a blocked road does not
# de-energise an electrical tower while a hospital still requires both power
# and water. Set to false for pure load-overload Motter-Lai propagation.
ENFORCE_EDGE_SEMANTICS=true

# --- Baseline topology source ---
# "synthetic" reads the committed seed fixture in data/seed.
# "osm" pulls the real road network for OSM_PLACE through the OSMnx pipeline
# and ingests that instead. Requires the optional dependency:
#   pip install 'ripple-backend[osm]'
TOPOLOGY_SOURCE=synthetic
OSM_PLACE=Manipal, Karnataka, India
OSM_NETWORK_TYPE=drive
OSM_CACHE_DIR=/data/osm

# --- Hosting without a worker or Neo4j (e.g. Vercel; README: "Deploying to Vercel") ---
# Every default below keeps the Docker stack's behaviour.
# "celery" queues runs for the worker; "inline" runs them inside the request.
SIMULATION_EXECUTION=celery
# false skips Neo4j entirely; centrality is then computed with NetworkX.
NEO4J_ENABLED=true
# Role for requests without an API key when API_KEY_AUTH_ENABLED=true:
# none (a key is required), viewer or operator. Admin always needs a key.
PUBLIC_ACCESS_ROLE=none
# Header a trusted proxy sets to the client's address, for per-visitor rate
# limits (x-real-ip on Vercel). Leave empty when clients connect directly.
CLIENT_IP_HEADER=
# Database connections kept per process; serverless hosts want 2 and 3.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Bearer token for GET /api/internal/cleanup (Vercel Cron sends it). Empty
# disables the endpoint. Runs and scenarios older than RETENTION_DAYS go.
CRON_SECRET=
RETENTION_DAYS=7
